{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/index.html"
    },
    {
      "source": "/de",
      "destination": "/de.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/ku",
      "destination": "/ku.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}